# 이 파일을 .env 로 복사해서 사용하세요.  (copy .env.example .env)

# 서버 포트 (직원들은 http://서버PC이름:3000 으로 접속)
PORT=3000

# ---- DB ----
# PostgreSQL 접속 주소. 설치 가이드(docs/설치가이드_Windows.md)에서 만든 계정·비밀번호로 바꾸세요.
DB_CLIENT=pg
DATABASE_URL=postgres://schedule:여기에비밀번호@localhost:5432/schedule
# (선택) 설치 없이 시험만 해 볼 때: DB_CLIENT=sqlite  → data/schedule.db 파일 하나에 저장
# SQLITE_FILE=data/schedule.db

# ---- 로그인 ----
# 로그인 유지 기간(일)
SESSION_DAYS=14
# HTTPS 로 서비스할 때 true
SECURE_COOKIE=false
# 세션 서명 키 (비워 두면 data/secret.key 를 자동 생성해 사용)
# SESSION_SECRET=

# ---- 백업 (매주 금요일 저녁, register-backup-task.bat 로 예약) ----
# 백업 파일 폴더 (기본: data/backups)
# BACKUP_DIR=D:\schedule-backup
# 추가로 복사해 둘 곳 (NAS, OneDrive 폴더 등). 서버 PC 고장에 대비해 다른 디스크/장비 권장
# BACKUP_COPY_DIR=\\NAS\backup\schedule
# 보관 개수 (기본 12개 = 약 3개월)
BACKUP_KEEP=12
# pg_dump 를 못 찾을 때만: PostgreSQL bin 폴더
# PG_BIN=C:\Program Files\PostgreSQL\17\bin

# ---- 번역 (입력 내용 번역, DeepL) ----
# DeepL API 키 (https://www.deepl.com/your-account/keys). 무료 키는 ":fx" 로 끝납니다.
# 비워 두면 "내용 번역" 기능만 꺼지고, 화면 언어(한국어·베트남어·영어) 선택은 그대로 됩니다.
# DEEPL_API_KEY=

# ---- 회의록 (녹음 → 음성인식 → AI 정리) ----
# 음성인식: 리턴제로 개발자센터(https://developers.rtzr.ai)에서 발급한 Client ID / Secret
# 비워 두면 녹음은 파일로만 보관되고 글로 바꾸지 않습니다.
# RTZR_CLIENT_ID=
# RTZR_CLIENT_SECRET=
# AI 정리: Claude API 키 (https://console.anthropic.com). 비워 두면 AI 정리만 꺼집니다.
# ANTHROPIC_API_KEY=
# AI 모델 (기본 claude-opus-5-5)
# MINUTES_AI_MODEL=claude-opus-5-5
# 녹음 파일 보관 폴더 (기본 data/meetings). DB 백업에는 포함되지 않으니 이 폴더도 따로 복사해 두세요.
# MEETINGS_DIR=D:\schedule-meetings
# 녹음 파일 최대 크기(MB, 기본 1024)
# MEETING_MAX_MB=1024

# ---- HTTPS (브라우저 녹음은 https 주소 또는 서버 PC 의 localhost 에서만 동작) ----
# make-https-cert.bat 을 실행하면 아래 값이 자동으로 들어갑니다. 회사 인증서가 있으면 그 파일을 지정하세요.
# HTTPS_PFX=data/https.pfx
# HTTPS_PASSPHRASE=
# 또는 PEM 파일:  HTTPS_CERT=...crt  HTTPS_KEY=...key

# ---- Microsoft 365 · Teams 연동 (안내: docs/M365_연동_안내.md) ----
# 아래 세 값이 없으면 연동만 꺼지고 아이디·비밀번호 로그인과 화면 알림(🔔)은 그대로 동작합니다.
# M365_TENANT_ID=
# M365_CLIENT_ID=
# M365_CLIENT_SECRET=
# 직원이 접속하는 주소 (메일·Teams 카드 바로가기, 로그인 리디렉션)
# PUBLIC_URL=https://schedule.company.co.kr
# 리디렉션 URI 를 PUBLIC_URL 과 다르게 등록했을 때만
# M365_REDIRECT_URI=
# 메일 알림을 보낼 사서함 (비우면 메일 알림만 꺼짐)
# M365_MAIL_FROM=schedule@company.co.kr
# 메일로 보낼 알림 종류 (비우면 전부)
# M365_MAIL_KINDS=task_assigned,review_requested,meeting_invited,task_due,task_late,milestone_due
# all = 회사 계정 + 아이디 로그인, admin = 아이디 로그인은 관리자만
# M365_LOCAL_LOGIN=all
# 처음 로그인한 회사 계정을 직원으로 자동 등록
# M365_AUTO_CREATE=true
# Outlook 일정 (회의 등록·초대·Teams 회의), 담당 작업도 종일 일정으로
# M365_OUTLOOK=true
# M365_OUTLOOK_TASKS=true
# M365_TIMEZONE=Korea Standard Time
# 하루 한 번 마감·마일스톤 알림, Teams 아침 요약 시각 (0~23, 기본 8)
# DAILY_NOTIFY_HOUR=8
