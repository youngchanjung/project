# 이 파일을 .env 로 복사해서 사용하세요. (모두 선택 항목)

# 서버 포트 (직원들은 http://서버PC이름:3000 으로 접속)
PORT=3000

# DB 종류: sqlite (기본, 서버 PC용) | pg (웹 버전, PostgreSQL)
DB_CLIENT=sqlite
# SQLite 파일 위치 (기본: data/schedule.db)
# SQLITE_FILE=data/schedule.db
# PostgreSQL 접속 주소 (DB_CLIENT=pg 일 때)
# DATABASE_URL=postgres://user:password@host:5432/schedule

# 로그인 유지 기간(일)
SESSION_DAYS=14
# HTTPS 로 서비스할 때 true
SECURE_COOKIE=false
# 세션 서명 키 (비워 두면 data/secret.key 를 자동 생성해 사용)
# SESSION_SECRET=
